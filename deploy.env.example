# Deploy profile for pterodactyl-mcp (https://github.com/N1jada/pterodactyl-mcp).
# No secrets here: your API key stays in pterodactyl-mcp's own .env.
#
# Copy this file to `.env.deploy` inside your pterodactyl-mcp folder. `dungeon deploy`
# loads it on top of that folder's .env (see --mcp-dir, default ../pterodactyl-mcp).
#
# Why it exists: pterodactyl-mcp protects world/** by default and datapacks live under
# world/datapacks/. This opens exactly the dungeon's datapack folder and nothing else.
# If you deploy with a different --remote-dir or namespace, change the path to match.

PTERODACTYL_UNPROTECTED_PATHS=world/datapacks/dungeon/**

# One dungeon is a few dozen files, plus room for a reload, build and restart.
PTERODACTYL_MAX_MUTATIONS=60

# `dungeon deploy` takes one explicit backup before writing anything, instead of one per
# file (many hosts only allow one or two backups per server).
PTERODACTYL_AUTO_BACKUP=false

PTERODACTYL_ALLOW_DELETE=false
PTERODACTYL_ALLOW_KILL=false
